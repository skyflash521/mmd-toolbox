{
  "permissions": {
    "allow": [
      "Bash(bash .claude/skills/codex-review-loop/watchdog.sh*)",
      "Bash(git blame *)",
      "Bash(git branch --list *)",
      "Bash(git branch --list)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -av)",
      "Bash(git branch -v)",
      "Bash(git branch)",
      "Bash(git config --get *)",
      "Bash(git config --list)",
      "Bash(git config -l)",
      "Bash(git describe *)",
      "Bash(git ls-files *)",
      "Bash(git ls-files)",
      "Bash(git ls-tree *)",
      "Bash(git merge-base *)",
      "Bash(git reflog show *)",
      "Bash(git reflog)",
      "Bash(git remote -v)",
      "Bash(git remote)",
      "Bash(git rev-list *)",
      "Bash(git rev-parse *)",
      "Bash(git shortlog *)",
      "Bash(git stash list)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git tag --list *)",
      "Bash(git tag --list)",
      "Bash(git tag -l *)",
      "Bash(git tag)",
      "Bash(git worktree list)",
      "Bash(node /*codex-companion.mjs*)",
      "Bash(node C:/*codex-companion.mjs*)",
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(python -m pytest)",
      "Bash(python -m pytest *)",
      "Bash(.venv/Scripts/pytest.exe)",
      "Bash(.venv/Scripts/pytest.exe *)",
      "Bash(./.venv/Scripts/pytest.exe)",
      "Bash(./.venv/Scripts/pytest.exe *)",
      "Bash(.venv/Scripts/python.exe -m pytest)",
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(./.venv/Scripts/python.exe -m pytest)",
      "Bash(./.venv/Scripts/python.exe -m pytest *)"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "node \"*codex-companion.mjs\"*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-approve-readonly.py\"",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
